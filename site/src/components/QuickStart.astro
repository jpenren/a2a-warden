---
// QuickStart.astro - Quick start section with installation and screenshots
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Quick Start",
  subtitle = "Get A2A Warden running in minutes. Single binary, zero external dependencies."
} = Astro.props;

const steps = [
  {
    number: 1,
    title: "Build the Binary",
    description: "Clone the repository and build with Cargo. The Rust toolchain is pinned for reproducibility.",
    code: `git clone https://github.com/jpenren/a2a-warden.git
cd a2a-warden
cargo build --release`,
    terminal: true,
  },
  {
    number: 2,
    title: "Start a Remote Agent",
    description: "Launch the example Python echo agent on port 9001. This simulates an A2A-compatible agent.",
    code: `python3 examples/sample-agents/echo-python/echo_agent.py --port 9001`,
    terminal: true,
  },
  {
    number: 3,
    title: "Run A2A Warden",
    description: "Start the Warden with the SQLite config. It will listen on port 8080 and connect to the echo agent.",
    code: `./target/release/a2a-warden --config examples/config/sqlite.yaml`,
    terminal: true,
  },
  {
    number: 4,
    title: "Open the Console",
    description: "Navigate to the embedded web console to see tasks, approvals, live traffic, and audit logs.",
    code: `open http://127.0.0.1:8080/ui`,
    terminal: false,
  },
];

const screenshots = [
  { src: "/a2a-warden/assets/tasks.png", alt: "Task list with pagination, status filters, and search", caption: "Task List — Pagination, filters, and debounced search" },
  { src: "/a2a-warden/assets/task-details.png", alt: "Task details view with timeline and actions", caption: "Task Details — Timeline, actions, and metadata" },
  { src: "/a2a-warden/assets/task-completed-details.png", alt: "Completed task with audit trail", caption: "Completed Task — Full audit trail and results" },
];

const endpoints = [
  { path: "/ui", label: "Web Console", desc: "Tasks, approvals, traffic, audit, search" },
  { path: "/api/v1/admin", label: "Admin API", desc: "Approvals, policies, agents, audit export" },
  { path: "/", label: "A2A JSON-RPC", desc: "POST endpoint for agent communication" },
  { path: "/.well-known/agent-card.json", label: "Agent Card", desc: "Signed Agent Card (JWS/JCS)" },
];

const demoCode = `# Send a task (waits for approval due to deny-by-default policy)
python3 examples/sample-agents/client-python/client_python.py \
  --warden http://127.0.0.1:8080 --text "hello from the demo"

# Get pending approval ID
APPROVAL=$(curl -s "http://127.0.0.1:8080/api/v1/admin/approvals?status=pending" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['approvals'][0]['id'])")

# Approve the task
curl -s -X POST "http://127.0.0.1:8080/api/v1/admin/approvals/$APPROVAL/decision" \
  -H 'content-type: application/json' \
  -d '{"decision": "approve", "approver": "demo-user", "reason": "looks fine"}'`;
---

<section id="quickstart" class="section" aria-labelledby="qs-title">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Get Started</span>
      <h2 id="qs-title" class="section-title">{title}</h2>
      <p class="section-description">{subtitle}</p>
    </header>
    
    <!-- Steps -->
    <div class="steps" aria-label="Installation steps">
      {steps.map((step, index) => (
        <article class="step" style="animation-delay: {index * 150}ms">
          <div class="step-number">{step.number}</div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
            <div class="code-block" data-lang={step.terminal ? "bash" : "text"}>
              <pre><code>{step.code}</code></pre>
              <button class="copy-btn" aria-label="Copy command" data-code={step.code}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
    
    <!-- Screenshots -->
    <div class="screenshots-section" aria-labelledby="screenshots-title">
      <h3 id="screenshots-title" class="screenshots-title">Embedded Web Console</h3>
      <p class="screenshots-hint">Click any screenshot to view full size</p>
      <div class="screenshots-grid" role="list">
        {screenshots.map((shot, index) => (
          <figure class="screenshot-card" role="listitem" style="animation-delay: {index * 100}ms" data-lightbox data-src={shot.src} data-alt={shot.alt} data-caption={shot.caption}>
            <div class="screenshot-frame">
              <img src={shot.src} alt={shot.alt} loading="lazy" />
              <div class="screenshot-overlay">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                <span>View full size</span>
              </div>
            </div>
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Screenshot preview" hidden>
      <div class="lightbox-backdrop" data-lightbox-close></div>
      <button class="lightbox-close" data-lightbox-close aria-label="Close preview">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous screenshot">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next screenshot">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="lightbox-content">
        <img id="lightbox-img" src="" alt="" />
        <div class="lightbox-caption" id="lightbox-caption"></div>
      </div>
    </div>
    
    <!-- Endpoints -->
    <div class="endpoints-section" aria-labelledby="endpoints-title">
      <h3 id="endpoints-title" class="endpoints-title">Available Endpoints</h3>
      <p class="endpoints-desc">Once running, the Warden exposes these endpoints on the configured address (default: <code class="inline-code">http://127.0.0.1:8080</code>).</p>
      <div class="grid grid--auto-sm">
        {endpoints.map(ep => (
          <div class="endpoint-card">
            <div class="endpoint-path">{ep.path}</div>
            <div class="endpoint-label">{ep.label}</div>
            <div class="endpoint-desc">{ep.desc}</div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Demo -->
    <div class="demo-section" aria-labelledby="demo-title">
      <h3 id="demo-title" class="demo-title">Try the Demo</h3>
      <p class="demo-desc">Send a test task and approve it via the admin API:</p>
      <div class="code-block" data-lang="bash">
        <pre><code>{`# Send a task (waits for approval due to deny-by-default policy)
python3 examples/sample-agents/client-python/client_python.py \
  --warden http://127.0.0.1:8080 --text "hello from the demo"

# Get pending approval ID
APPROVAL=$(curl -s "http://127.0.0.1:8080/api/v1/admin/approvals?status=pending" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['approvals'][0]['id'])")

# Approve the task
curl -s -X POST "http://127.0.0.1:8080/api/v1/admin/approvals/$APPROVAL/decision" \
  -H 'content-type: application/json' \
  -d '{"decision": "approve", "approver": "demo-user", "reason": "looks fine"}'`}</code></pre>
        <button class="copy-btn" aria-label="Copy demo commands" data-code={demoCode}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }
  
  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-purple) 100%);
    color: white;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }
  
  .step-content {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }
  
  .step-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }
  
  .step-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }
  
  .step .code-block {
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  
  .step .code-block pre {
    padding: var(--space-md);
  }
  
  .step .copy-btn {
    top: var(--space-sm);
    right: var(--space-sm);
    padding: var(--space-xs);
  }
  
  /* Screenshots */
  .screenshots-section {
    margin-bottom: var(--space-4xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }
  
  .screenshots-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  
  .screenshot-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
  }
  
  .screenshot-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .screenshot-frame {
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
    overflow: hidden;
  }
  
  .screenshot-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .screenshot-card:hover .screenshot-frame img {
    transform: scale(1.02);
  }
  
  .screenshot-card figcaption {
    padding: var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
  }
  
  /* Endpoints */
  .endpoints-section {
    margin-bottom: var(--space-4xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }
  
  .endpoints-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--space-sm);
  }
  
  .endpoints-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-align: center;
    margin-bottom: var(--space-xl);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .endpoint-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    text-align: center;
    transition: all var(--transition-base);
  }
  
  .endpoint-card:hover {
    border-color: var(--color-accent-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  
  .endpoint-path {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  
  .endpoint-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  
  .endpoint-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  
  /* Demo */
  .demo-section {
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }
  
  .demo-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--space-sm);
  }
  
  .demo-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .demo-section .code-block {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  .demo-section .code-block pre {
    padding: var(--space-xl);
  }
  
  .demo-section .copy-btn {
    top: var(--space-md);
    right: var(--space-md);
  }
  
  @media (max-width: 900px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    .step {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    
    .step-number {
      width: 40px;
      height: 40px;
      font-size: 1.25rem;
    }
  }
  
  /* Screenshots hint */
  .screenshots-hint {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }
  
  /* Screenshot overlay */
  .screenshot-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 15, 26, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    opacity: 0;
    transition: opacity var(--transition-base);
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .screenshot-overlay svg {
    width: 32px;
    height: 32px;
    stroke-width: 1.5;
  }
  
  .screenshot-card:hover .screenshot-overlay {
    opacity: 1;
  }
  
  .screenshot-card[data-lightbox] {
    cursor: zoom-in;
  }
  
  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
  }
  
  .lightbox[hidden] {
    display: none;
  }
  
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(4px);
    animation: fadeIn var(--transition-fast);
  }
  
  .lightbox-close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .lightbox-close:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text);
    border-color: var(--color-border-light);
  }
  
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }
  
  .lightbox-nav:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text);
    border-color: var(--color-accent-border);
  }
  
  .lightbox-prev { left: var(--space-lg); }
  .lightbox-next { right: var(--space-lg); }
  
  @media (max-width: 768px) {
    .lightbox-nav { width: 44px; height: 44px; }
    .lightbox-prev { left: var(--space-md); }
    .lightbox-next { right: var(--space-md); }
    .lightbox-close { top: var(--space-md); right: var(--space-md); width: 40px; height: 40px; }
  }
  
  .lightbox-content {
    max-width: 95vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeInUp var(--transition-base);
  }
  
  .lightbox-content img {
    max-width: 100%;
    max-height: 80vh;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    object-fit: contain;
  }
  
  .lightbox-caption {
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 800px;
    padding: 0 var(--space-md);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code;
      try {
        await navigator.clipboard.writeText(code);
        const svg = btn.querySelector('svg');
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
        btn.style.color = 'var(--color-success)';
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.style.color = '';
        }, 1500);
      } catch (e) {
        console.error('Failed to copy:', e);
      }
    });
  });
  
  // Lightbox functionality
  (() => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const screenshots = Array.from(document.querySelectorAll('[data-lightbox]'));
    let currentIndex = 0;
    
    function openLightbox(index) {
      currentIndex = index;
      const shot = screenshots[currentIndex];
      lightboxImg.src = shot.dataset.src;
      lightboxImg.alt = shot.dataset.alt;
      lightboxCaption.textContent = shot.dataset.caption;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      updateNavButtons();
    }
    
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.src = '';
      lightboxCaption.textContent = '';
      document.body.style.overflow = '';
    }
    
    function navigate(direction) {
      currentIndex = (currentIndex + direction + screenshots.length) % screenshots.length;
      openLightbox(currentIndex);
    }
    
    function updateNavButtons() {
      // Always show nav buttons for multiple screenshots
    }
    
    // Click on screenshot cards
    screenshots.forEach((shot, index) => {
      shot.addEventListener('click', () => openLightbox(index));
      shot.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(index);
        }
      });
      shot.setAttribute('tabindex', '0');
      shot.setAttribute('role', 'button');
      shot.setAttribute('aria-label', `View ${shot.dataset.caption} full size`);
    });
    
    // Close buttons
    lightbox.querySelectorAll('[data-lightbox-close]').forEach(btn => {
      btn.addEventListener('click', closeLightbox);
    });
    
    // Navigation buttons
    lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => navigate(-1));
    lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => navigate(1));
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });
    
    // Touch swipe support
    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        navigate(diff > 0 ? 1 : -1);
      }
    }, { passive: true });
  })();
</script>