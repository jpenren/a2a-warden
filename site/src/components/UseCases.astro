---
// UseCases.astro - Interactive use case diagrams
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "How It Works",
  subtitle = "Visual walkthroughs of common agent communication patterns with A2A Warden."
} = Astro.props;
---

<section id="use-cases" class="section" aria-labelledby="usecases-title">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Use Cases</span>
      <h2 id="usecases-title" class="section-title">{title}</h2>
      <p class="section-description">{subtitle}</p>
    </header>
    
    <!-- Use Case 1: Basic Communication -->
    <article class="use-case" id="usecase-communication">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">01</span>
          <div>
            <h3 class="use-case-title">Basic Agent Communication</h3>
            <p class="use-case-desc">Agent A sends a task to Agent B through the Warden. All traffic is recorded, Agent Cards are verified, and the message flow is fully observable.</p>
          </div>
        </div>
        <div class="use-case-diagram" role="img" aria-label="Sequence diagram: Agent A creates task → Warden records → Warden verifies Agent Card → Warden forwards to Agent B → Agent B responds → Warden records response → Agent A receives result">
          <svg viewBox="0 0 720 320" xmlns="http://www.w3.org/2000/svg" class="seq-diagram">
            <defs>
              <marker id="seq-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 Z" fill="var(--color-accent)" />
              </marker>
              <marker id="seq-arrow-dash" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 Z" fill="var(--color-text-muted)" />
              </marker>
              <marker id="seq-arrow-green" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 Z" fill="var(--color-success)" />
              </marker>
              <filter id="seq-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="2" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>
            
            <!-- Lifelines -->
            <g class="lifeline" style="transform: translate(60px, 20px)">
              <rect x="0" y="0" width="120" height="50" rx="8" fill="var(--color-bg-card)" stroke="var(--color-accent)" stroke-width="2"/>
              <text x="60" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-accent)">Agent A</text>
              <line x1="60" y1="50" x2="60" y2="280" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="8 6" opacity="0.5"/>
              <circle cx="60" cy="280" r="6" fill="var(--color-accent)"/>
            </g>
            
            <g class="lifeline" style="transform: translate(300px, 20px)">
              <rect x="0" y="0" width="120" height="50" rx="8" fill="var(--color-bg-card)" stroke="var(--color-purple)" stroke-width="2" filter="url(#seq-glow)"/>
              <text x="60" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-purple)">A2A Warden</text>
              <line x1="60" y1="50" x2="60" y2="280" stroke="var(--color-purple)" stroke-width="2" stroke-dasharray="8 6" opacity="0.5"/>
              <circle cx="60" cy="280" r="6" fill="var(--color-purple)"/>
            </g>
            
            <g class="lifeline" style="transform: translate(540px, 20px)">
              <rect x="0" y="0" width="120" height="50" rx="8" fill="var(--color-bg-card)" stroke="var(--color-success)" stroke-width="2"/>
              <text x="60" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-success)">Agent B</text>
              <line x1="60" y1="50" x2="60" y2="280" stroke="var(--color-success)" stroke-width="2" stroke-dasharray="8 6" opacity="0.5"/>
              <circle cx="60" cy="280" r="6" fill="var(--color-success)"/>
            </g>
            
            <!-- Messages -->
            <!-- 1. createTask -->
            <g class="msg" style="transform: translate(180px, 80px)">
              <path d="M0 0 L120 0" fill="none" stroke="var(--color-accent)" stroke-width="2" marker-end="url(#seq-arrow)"/>
              <text x="60" y="-8" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text)">createTask()</text>
              <text x="60" y="16" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">{`{ skill: "echo", params: {...} }`}</text>
            </g>
            
            <!-- 2. Record & Verify -->
            <g class="msg" style="transform: translate(360px, 100px)">
              <rect x="-100" y="-20" width="200" height="40" rx="6" fill="var(--color-accent-bg)" stroke="var(--color-accent-border)" stroke-width="1"/>
              <text x="0" y="0" text-anchor="middle" font-family="var(--font-sans)" font-size="10" fill="var(--color-accent)" font-weight="500">Record Traffic</text>
              <text x="0" y="14" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Verify JWS/JCS Card</text>
            </g>
            
            <!-- 3. Policy Check -->
            <g class="msg" style="transform: translate(360px, 140px)">
              <rect x="-100" y="-20" width="200" height="40" rx="6" fill="var(--color-purple-bg)" stroke="var(--color-purple-border)" stroke-width="1"/>
              <text x="0" y="0" text-anchor="middle" font-family="var(--font-sans)" font-size="10" fill="var(--color-purple)" font-weight="500">Policy Evaluation</text>
              <text x="0" y="14" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Cedar: allow/deny/escalate</text>
            </g>
            
            <!-- 4. Forward to Agent B -->
            <g class="msg" style="transform: translate(420px, 180px)">
              <path d="M0 0 L120 0" fill="none" stroke="var(--color-success)" stroke-width="2" marker-end="url(#seq-arrow-green)"/>
              <text x="60" y="-8" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text)">forwardTask()</text>
              <text x="60" y="16" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">message_id preserved</text>
            </g>
            
            <!-- 5. Response -->
            <g class="msg" style="transform: translate(180px, 220px)">
              <path d="M120 0 L0 0" fill="none" stroke="var(--color-success)" stroke-width="2" marker-end="url(#seq-arrow-green)" style="transform: rotate(180deg) translate(-120, 0); transform-origin: center;"/>
              <text x="60" y="-8" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text)">TaskStatusUpdate</text>
              <text x="60" y="16" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">{`{ state: "completed", result: {...} }`}</text>
            </g>
            
            <!-- 6. Record Response -->
            <g class="msg" style="transform: translate(360px, 240px)">
              <rect x="-100" y="-20" width="200" height="40" rx="6" fill="var(--color-success-bg)" stroke="var(--color-success-border)" stroke-width="1"/>
              <text x="0" y="0" text-anchor="middle" font-family="var(--font-sans)" font-size="10" fill="var(--color-success)" font-weight="500">Record Response</text>
              <text x="0" y="14" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Audit log entry</text>
            </g>
            
            <!-- 7. Return to Agent A -->
            <g class="msg" style="transform: translate(180px, 260px)">
              <path d="M0 0 L120 0" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#seq-arrow-dash)"/>
              <text x="60" y="-8" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">return result</text>
            </g>
          </svg>
        </div>
      </div>
    </article>
    
    <!-- Use Case 2: Human Approval -->
    <article class="use-case" id="usecase-approval">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">02</span>
          <div>
            <h3 class="use-case-title">Human-in-the-Loop Approval</h3>
            <p class="use-case-desc">Cedar policy escalates a task for human approval. Supervisor reviews in the embedded console, approves or rejects, and the Warden executes or denies accordingly.</p>
          </div>
        </div>
        <div class="use-case-diagram" role="img" aria-label="Flow diagram showing task escalation, pending approval, human decision, and execution">
          <div class="approval-flow">
            <div class="flow-step">
              <div class="step-node" style="background: var(--color-accent-bg); border-color: var(--color-accent-border); color: var(--color-accent);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </div>
              <div class="step-info">
                <h4>Task Created</h4>
                <p>Agent A submits <code>create-order</code> task</p>
                <span class="step-status status-info">input-required</span>
              </div>
            </div>
            <div class="flow-arrow" style="background: var(--color-accent);"></div>
            
            <div class="flow-step">
              <div class="step-node" style="background: var(--color-purple-bg); border-color: var(--color-purple-border); color: var(--color-purple);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              </div>
              <div class="step-info">
                <h4>Policy Escalated</h4>
                <p>Cedar rule matches: <code>skill == 'create-order'</code></p>
                <span class="step-status status-warning">escalated</span>
              </div>
            </div>
            <div class="flow-arrow" style="background: var(--color-purple);"></div>
            
            <div class="flow-step">
              <div class="step-node" style="background: var(--color-warning-bg); border-color: var(--color-warning-border); color: var(--color-warning);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="step-info">
                <h4>Pending Approval</h4>
                <p>Task paused, visible in <code>/ui</code> and <code>/api/v1/admin/approvals</code></p>
                <span class="step-status status-pending">pending</span>
              </div>
            </div>
            <div class="flow-arrow" style="background: var(--color-warning);"></div>
            
            <div class="flow-step decision">
              <div class="step-node" style="background: var(--color-success-bg); border-color: var(--color-success-border); color: var(--color-success);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="step-info">
                <h4>Human Decision</h4>
                <p>Supervisor clicks <strong>Approve</strong> or <strong>Reject</strong> in console</p>
                <div class="decision-btns">
                  <button class="btn btn--success btn--sm" disabled>Approve</button>
                  <button class="btn btn--danger btn--sm" disabled>Reject</button>
                </div>
              </div>
            </div>
            <div class="flow-arrow" style="background: var(--color-success);"></div>
            
            <div class="flow-step">
              <div class="step-node" style="background: var(--color-success-bg); border-color: var(--color-success-border); color: var(--color-success);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="step-info">
                <h4>Executed & Audited</h4>
                <p>Task forwarded to Agent B, result recorded in hash-chained audit log</p>
                <span class="step-status status-success">completed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
    
    <!-- Use Case 3: Multi-Agent Pizza Shop -->
    <article class="use-case" id="usecase-pizza">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">03</span>
          <div>
            <h3 class="use-case-title">Multi-Agent Workflow: Pizza Shop</h3>
            <p class="use-case-desc">Four agents (Order, Inventory, Payments, Delivery) coordinate through the Warden. Two skills require human approval: refund-order and charge-order over threshold.</p>
          </div>
        </div>
        <div class="use-case-diagram" role="img" aria-label="Pizza shop architecture: Client → Order Agent → Inventory Agent → Payments Agent → Delivery Agent, all through Warden with approval gates">
          <svg viewBox="0 0 800 280" xmlns="http://www.w3.org/2000/svg" class="pizza-diagram">
            <defs>
              <marker id="pizza-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 Z" fill="var(--color-text-muted)" />
              </marker>
              <marker id="pizza-arrow-accent" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 Z" fill="var(--color-accent)" />
              </marker>
              <filter id="pizza-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>
            
            <!-- Warden Center -->
            <g class="pizza-warden" style="transform: translate(280px, 40px)" filter="url(#pizza-glow)">
              <rect x="0" y="0" width="240" height="200" rx="16" fill="var(--color-bg-card)" stroke="url(#grad-warden)" stroke-width="2"/>
              <defs>
                <linearGradient id="grad-warden" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:var(--color-accent)"/>
                  <stop offset="100%" style="stop-color:var(--color-purple)"/>
                </linearGradient>
              </defs>
              <rect x="0" y="0" width="240" height="48" rx="16" fill="var(--color-accent-bg)"/>
              <text x="120" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="14" font-weight="700" fill="var(--color-accent)">A2A Warden</text>
              <text x="120" y="50" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">Hub: Record · Verify · Policy · Approve</text>
              
              <g style="transform: translate(20px, 70px)">
                <rect x="0" y="0" width="200" height="36" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1"/>
                <text x="100" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text)">A2A JSON-RPC Endpoint</text>
              </g>
              <g style="transform: translate(20px, 115px)">
                <rect x="0" y="0" width="95" height="36" rx="8" fill="var(--color-purple-bg)" stroke="var(--color-purple-border)" stroke-width="1"/>
                <text x="47" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-purple)">Cedar Policy</text>
              </g>
              <g style="transform: translate(125px, 115px)">
                <rect x="0" y="0" width="95" height="36" rx="8" fill="var(--color-warning-bg)" stroke="var(--color-warning-border)" stroke-width="1"/>
                <text x="47" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-warning)">Approvals</text>
              </g>
              <g style="transform: translate(20px, 160px)">
                <rect x="0" y="0" width="200" height="36" rx="8" fill="var(--color-cyan-bg)" stroke="var(--color-cyan-border)" stroke-width="1"/>
                <text x="100" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-cyan)">Hash-Chained Audit Log</text>
              </g>
            </g>
            
            <!-- Client -->
            <g class="pizza-agent" style="transform: translate(30px, 100px)">
              <rect x="0" y="0" width="140" height="80" rx="12" fill="var(--color-bg-card)" stroke="var(--color-cyan)" stroke-width="1.5"/>
              <text x="70" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-cyan)">Client</text>
              <text x="70" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">place_order.py</text>
              <text x="70" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-secondary)">createTask(order)</text>
            </g>
            
            <!-- Order Agent -->
            <g class="pizza-agent" style="transform: translate(30px, 20px)">
              <rect x="0" y="0" width="140" height="80" rx="12" fill="var(--color-bg-card)" stroke="var(--color-accent)" stroke-width="1.5"/>
              <text x="70" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-accent)">Order Agent</text>
              <text x="70" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">a2a-python SDK</text>
              <text x="70" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-secondary)">checkInventory()</text>
            </g>
            
            <!-- Inventory Agent -->
            <g class="pizza-agent" style="transform: translate(560px, 20px)">
              <rect x="0" y="0" width="140" height="80" rx="12" fill="var(--color-bg-card)" stroke="var(--color-success)" stroke-width="1.5"/>
              <text x="70" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-success)">Inventory</text>
              <text x="70" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">a2a-python SDK</text>
              <text x="70" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-secondary)">reserveItems()</text>
            </g>
            
            <!-- Payments Agent -->
            <g class="pizza-agent" style="transform: translate(560px, 100px)">
              <rect x="0" y="0" width="140" height="80" rx="12" fill="var(--color-bg-card)" stroke="var(--color-warning)" stroke-width="1.5"/>
              <text x="70" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-warning)">Payments</text>
              <text x="70" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">a2a-python SDK</text>
              <text x="70" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-secondary)">chargeOrder() ⚠️</text>
            </g>
            
            <!-- Delivery Agent -->
            <g class="pizza-agent" style="transform: translate(560px, 180px)">
              <rect x="0" y="0" width="140" height="80" rx="12" fill="var(--color-bg-card)" stroke="var(--color-purple)" stroke-width="1.5"/>
              <text x="70" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-purple)">Delivery</text>
              <text x="70" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">a2a-python SDK</text>
              <text x="70" y="65" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-secondary)">scheduleDelivery()</text>
            </g>
            
            <!-- Arrows -->
            <path d="M170 60 Q225 60 280 100" fill="none" stroke="var(--color-accent)" stroke-width="2" marker-end="url(#pizza-arrow-accent)" stroke-dasharray="6 4"/>
            <path d="M170 130 Q225 130 280 100" fill="none" stroke="var(--color-accent)" stroke-width="2" marker-end="url(#pizza-arrow-accent)" stroke-dasharray="6 4"/>
            
            <path d="M200 40 Q300 40 400 40" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5" marker-end="url(#pizza-arrow)" stroke-dasharray="4 4"/>
            <path d="M200 60 Q300 60 400 60" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5" marker-end="url(#pizza-arrow)" stroke-dasharray="4 4"/>
            
            <path d="M420 140 Q490 140 560 140" fill="none" stroke="var(--color-warning)" stroke-width="2" marker-end="url(#pizza-arrow-accent)"/>
            <text x="490" y="135" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-warning)">escalate: charge-order</text>
            
            <path d="M420 220 Q490 220 560 220" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5" marker-end="url(#pizza-arrow)" stroke-dasharray="4 4"/>
            
            <!-- Approval badges -->
            <g style="transform: translate(520px, 70px)">
              <rect x="0" y="0" width="120" height="28" rx="14" fill="var(--color-warning-bg)" stroke="var(--color-warning-border)" stroke-width="1"/>
              <text x="60" y="18" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-warning)">⚠ Approval Required</text>
            </g>
          </svg>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .use-case {
    margin-bottom: var(--space-4xl);
    padding-bottom: var(--space-4xl);
    border-bottom: 1px solid var(--color-border);
  }
  
  .use-case:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  
  .use-case-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  
  @media (min-width: 900px) {
    .use-case-content {
      grid-template-columns: 380px 1fr;
      align-items: start;
    }
    
    .use-case:nth-child(even) .use-case-content {
      direction: rtl;
    }
    
