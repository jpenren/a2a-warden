---
// UseCases.astro - Visual walkthroughs of common agent communication patterns
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "How It Works",
  subtitle = "Visual walkthroughs of common agent communication patterns with A2A Warden."
} = Astro.props;
---

<section id="use-cases" class="section" aria-labelledby="usecases-title">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Use Cases</span>
      <h2 id="usecases-title" class="section-title">{title}</h2>
      <p class="section-description">{subtitle}</p>
    </header>

    <!-- Use Case 1: Basic Communication -->
    <article class="use-case" id="usecase-communication">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">01</span>
          <h3 class="use-case-title">Basic Agent Communication</h3>
          <p class="use-case-desc">Agent A sends a task to Agent B through the Warden. All traffic is recorded, Agent Cards are verified, and the message flow is fully observable.</p>
        </div>

        <div class="use-case-diagram">
          <div class="diagram-scroll">
            <svg viewBox="0 0 760 472" xmlns="http://www.w3.org/2000/svg" class="seq-diagram" role="img" aria-label="Sequence diagram: Agent A creates a task, the Warden records and verifies it, evaluates Cedar policy, forwards it to Agent B, records the response, and returns the result to Agent A">
              <defs>
                <marker id="seq-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
                  <path d="M0 0 L9 4.5 L0 9 Z" fill="var(--color-accent)" />
                </marker>
                <marker id="seq-arrow-success" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
                  <path d="M0 0 L9 4.5 L0 9 Z" fill="var(--color-success)" />
                </marker>
                <marker id="seq-arrow-muted" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
                  <path d="M0 0 L9 4.5 L0 9 Z" fill="var(--color-text-muted)" />
                </marker>
              </defs>

              <!-- Actors -->
              <g>
                <rect x="20" y="6" width="180" height="60" rx="12" fill="var(--color-bg)" stroke="var(--color-accent-border)" stroke-width="1.5" />
                <text x="110" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--color-accent)">Agent A</text>
                <text x="110" y="49" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">Python SDK</text>
              </g>
              <g>
                <rect x="290" y="6" width="180" height="60" rx="12" fill="var(--color-purple-bg)" stroke="var(--color-purple-border)" stroke-width="1.5" />
                <text x="380" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--color-purple)">A2A Warden</text>
                <text x="380" y="49" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">trust boundary</text>
              </g>
              <g>
                <rect x="560" y="6" width="180" height="60" rx="12" fill="var(--color-bg)" stroke="var(--color-success-border)" stroke-width="1.5" />
                <text x="650" y="30" text-anchor="middle" font-family="var(--font-sans)" font-size="13" font-weight="700" fill="var(--color-success)">Agent B</text>
                <text x="650" y="49" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">Rust SDK</text>
              </g>

              <!-- Lifelines -->
              <line x1="110" y1="66" x2="110" y2="452" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.35" />
              <line x1="380" y1="66" x2="380" y2="452" stroke="var(--color-purple)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.35" />
              <line x1="650" y1="66" x2="650" y2="452" stroke="var(--color-success)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.35" />
              <circle cx="110" cy="452" r="4" fill="var(--color-accent)" />
              <circle cx="380" cy="452" r="4" fill="var(--color-purple)" />
              <circle cx="650" cy="452" r="4" fill="var(--color-success)" />

              <!-- 1. createTask -->
              <text x="245" y="96" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text)">createTask()</text>
              <text x="245" y="110" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-muted)">skill: echo</text>
              <line x1="110" y1="118" x2="371" y2="118" stroke="var(--color-accent)" stroke-width="2" marker-end="url(#seq-arrow)" />

              <!-- 2. Record and verify -->
              <rect x="250" y="142" width="260" height="44" rx="10" fill="var(--color-accent-bg)" stroke="var(--color-accent-border)" stroke-width="1" />
              <text x="380" y="161" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-accent)">Record &amp; verify</text>
              <text x="380" y="177" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Traffic logged · signed Agent Card</text>

              <!-- 3. Policy evaluation -->
              <rect x="250" y="204" width="260" height="44" rx="10" fill="var(--color-purple-bg)" stroke="var(--color-purple-border)" stroke-width="1" />
              <text x="380" y="223" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-purple)">Policy evaluation</text>
              <text x="380" y="239" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Cedar: allow / deny / escalate</text>

              <!-- 4. forwardTask -->
              <text x="515" y="264" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text)">forwardTask()</text>
              <text x="515" y="278" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-muted)">message_id preserved</text>
              <line x1="380" y1="286" x2="641" y2="286" stroke="var(--color-success)" stroke-width="2" marker-end="url(#seq-arrow-success)" />

              <!-- 5. TaskStatusUpdate -->
              <text x="515" y="314" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text)">TaskStatusUpdate</text>
              <text x="515" y="328" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-text-muted)">state: completed</text>
              <line x1="650" y1="336" x2="389" y2="336" stroke="var(--color-success)" stroke-width="2" marker-end="url(#seq-arrow-success)" />

              <!-- 6. Record response -->
              <rect x="250" y="360" width="260" height="44" rx="10" fill="var(--color-success-bg)" stroke="var(--color-success-border)" stroke-width="1" />
              <text x="380" y="379" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-success)">Record response</text>
              <text x="380" y="395" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">Append to hash-chained audit log</text>

              <!-- 7. Return result -->
              <text x="245" y="420" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--color-text-muted)">return result</text>
              <line x1="380" y1="440" x2="119" y2="440" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#seq-arrow-muted)" />
            </svg>
          </div>
          <p class="diagram-hint">Scroll horizontally to see the full sequence on small screens.</p>
        </div>
      </div>
    </article>

    <!-- Use Case 2: Human Approval -->
    <article class="use-case" id="usecase-approval">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">02</span>
          <h3 class="use-case-title">Human-in-the-Loop Approval</h3>
          <p class="use-case-desc">Cedar policy escalates a task for human approval. A supervisor reviews it in the embedded console, approves or rejects it, and the Warden executes or denies accordingly.</p>
        </div>

        <div class="use-case-diagram">
          <div class="approval-flow" role="group" aria-label="Flow diagram showing task creation, policy escalation, pending approval, human decision, and audited execution">
            <div class="flow-step">
              <div class="step-node" data-tone="accent">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </div>
              <div class="step-info">
                <h4>Task Created</h4>
                <p>Agent A submits a <code>create-order</code> task</p>
                <span class="step-status status-info">input-required</span>
              </div>
            </div>

            <div class="flow-arrow" data-tone="accent" aria-hidden="true"></div>

            <div class="flow-step">
              <div class="step-node" data-tone="purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              </div>
              <div class="step-info">
                <h4>Policy Escalated</h4>
                <p>Cedar rule matches <code>skill == 'create-order'</code></p>
                <span class="step-status status-warning">escalated</span>
              </div>
            </div>

            <div class="flow-arrow" data-tone="purple" aria-hidden="true"></div>

            <div class="flow-step">
              <div class="step-node" data-tone="warning">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="step-info">
                <h4>Pending Approval</h4>
                <p>Task pauses and appears in <code>/ui</code></p>
                <span class="step-status status-pending">pending</span>
              </div>
            </div>

            <div class="flow-arrow" data-tone="warning" aria-hidden="true"></div>

            <div class="flow-step flow-step--decision">
              <div class="step-node" data-tone="success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="step-info">
                <h4>Human Decision</h4>
                <p>Supervisor clicks <strong>Approve</strong> or <strong>Reject</strong></p>
                <div class="decision-btns">
                  <button class="btn btn--success btn--sm" disabled>Approve</button>
                  <button class="btn btn--danger btn--sm" disabled>Reject</button>
                </div>
              </div>
            </div>

            <div class="flow-arrow" data-tone="success" aria-hidden="true"></div>

            <div class="flow-step">
              <div class="step-node" data-tone="success">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="step-info">
                <h4>Executed &amp; Audited</h4>
                <p>Task reaches Agent B; the result is written to the audit log</p>
                <span class="step-status status-success">completed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Use Case 3: Multi-Agent Pizza Shop -->
    <article class="use-case" id="usecase-pizza">
      <div class="use-case-content">
        <div class="use-case-header">
          <span class="use-case-number">03</span>
          <h3 class="use-case-title">Multi-Agent Workflow: Pizza Shop</h3>
          <p class="use-case-desc">A client places an order; the Order Agent coordinates Inventory, Payments, and Delivery through the Warden. Two skills require human approval: <code>refund-order</code> and <code>charge-order</code> above threshold.</p>
        </div>

        <div class="use-case-diagram">
          <div class="pizza-flow" role="group" aria-label="Pizza shop architecture: Client to Order Agent to A2A Warden, which routes requests to Inventory, Payments, and Delivery agents. Payments escalates to human approval.">
            <div class="pizza-col">
              <div class="pizza-node" data-tone="cyan">
                <div class="pizza-node-head">
                  <span class="pizza-node-title">Client</span>
                  <span class="pizza-tag">caller</span>
                </div>
                <code>place_order.py</code>
                <span class="pizza-node-desc">createTask(order)</span>
              </div>

              <div class="pizza-local" aria-hidden="true">
                <span>createTask</span>
              </div>

              <div class="pizza-node" data-tone="accent">
                <div class="pizza-node-head">
                  <span class="pizza-node-title">Order Agent</span>
                  <span class="pizza-tag">a2a-python</span>
                </div>
                <code>checkInventory()</code>
                <span class="pizza-node-desc">Orchestrates the workflow</span>
              </div>
            </div>

            <div class="pizza-connector" aria-hidden="true">
              <span class="pizza-connector-label">routes by skill</span>
              <span class="pizza-connector-line"></span>
            </div>

            <div class="pizza-hub">
              <div class="pizza-hub-head">
                <span class="pizza-hub-title">A2A Warden</span>
                <span class="pizza-hub-sub">hub</span>
              </div>
              <div class="pizza-hub-grid">
                <div class="pizza-module" data-tone="accent">
                  <strong>JSON-RPC</strong>
                  <span>A2A endpoint</span>
                </div>
                <div class="pizza-module" data-tone="purple">
                  <strong>Cedar Policy</strong>
                  <span>allow · deny · escalate</span>
                </div>
                <div class="pizza-module" data-tone="warning">
                  <strong>Approvals</strong>
                  <span>human decision</span>
                </div>
                <div class="pizza-module" data-tone="cyan">
                  <strong>Audit Log</strong>
                  <span>hash-chained</span>
                </div>
              </div>
            </div>

            <div class="pizza-connector pizza-connector--out" aria-hidden="true">
              <span class="pizza-connector-label">allow · escalate</span>
              <span class="pizza-connector-line"></span>
            </div>

            <div class="pizza-col">
              <div class="pizza-node" data-tone="success">
                <div class="pizza-node-head">
                  <span class="pizza-node-title">Inventory</span>
                  <span class="pizza-tag">a2a-python</span>
                </div>
                <code>reserveItems()</code>
                <span class="pizza-node-desc">Stock reservation</span>
              </div>

              <div class="pizza-node" data-tone="warning">
                <div class="pizza-node-head">
                  <span class="pizza-node-title">Payments</span>
                  <span class="pizza-badge">approval</span>
                </div>
                <code>chargeOrder()</code>
                <span class="pizza-node-desc">Pauses above threshold</span>
              </div>

              <div class="pizza-node" data-tone="purple">
                <div class="pizza-node-head">
                  <span class="pizza-node-title">Delivery</span>
                  <span class="pizza-tag">a2a-python</span>
                </div>
                <code>scheduleDelivery()</code>
                <span class="pizza-node-desc">Schedules the drop-off</span>
              </div>
            </div>
          </div>

          <p class="diagram-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><code>charge-order</code> and <code>refund-order</code> pause for human approval before any payment mutation.</span>
          </p>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .use-case {
    margin-bottom: clamp(4rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-border);
  }
  
  .use-case:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  
  .use-case-content {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: stretch;
  }
  
  .use-case-number {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    background: var(--color-accent-bg);
    border: 1px solid var(--color-accent-border);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }
  
  .use-case-title {
    font-size: clamp(1.35rem, 3vw, 1.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  
  .use-case-desc {
    font-size: 0.9688rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  
  .use-case-desc code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-accent);
    background: var(--color-accent-bg);
    border: 1px solid var(--color-accent-border);
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
  }
  
  .use-case-diagram {
    min-width: 0;
    background:
      radial-gradient(ellipse at 50% 0%, var(--color-accent-bg) 0%, transparent 60%),
      var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1rem, 3vw, 2rem);
    box-shadow: var(--shadow-md);
  }
  
  .diagram-scroll {
    overflow: hidden;
    scrollbar-color: var(--color-border-light) transparent;
  }
  
  .seq-diagram {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
  
  .diagram-hint {
    display: none;
    margin: var(--space-md) 0 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  
  @media (max-width: 720px) {
    .diagram-hint {
      display: block;
    }
  }
  
  /* Approval flow */
  .approval-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: var(--space-sm);
  }
  
  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-sm);
    position: relative;
    z-index: 2;
  }
  
  .step-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    border: 1px solid;
    flex-shrink: 0;
  }
  
  .step-node[data-tone="accent"] {
    background: var(--color-accent-bg);
    border-color: var(--color-accent-border);
    color: var(--color-accent);
  }
  
  .step-node[data-tone="purple"] {
    background: var(--color-purple-bg);
    border-color: var(--color-purple-border);
    color: var(--color-purple);
  }
  
  .step-node[data-tone="warning"] {
    background: var(--color-warning-bg);
    border-color: var(--color-warning-border);
    color: var(--color-warning);
  }
  
  .step-node[data-tone="success"] {
    background: var(--color-success-bg);
    border-color: var(--color-success-border);
    color: var(--color-success);
  }
  
  .step-info {
    text-align: center;
    min-width: 150px;
    max-width: 190px;
  }
  
  .step-info h4 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  
  .step-info p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  
  .step-info code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  
  .step-status {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
  }
  
  .status-info { background: var(--color-accent-bg); color: var(--color-accent); border: 1px solid var(--color-accent-border); }
  .status-warning { background: var(--color-purple-bg); color: var(--color-purple); border: 1px solid var(--color-purple-border); }
  .status-pending { background: var(--color-warning-bg); color: var(--color-warning); border: 1px solid var(--color-warning-border); }
  .status-success { background: var(--color-success-bg); color: var(--color-success); border: 1px solid var(--color-success-border); }
  
  .decision-btns {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
  
  .flow-arrow {
    width: 32px;
    height: 2px;
    border-radius: 2px;
    flex-shrink: 0;
    opacity: 0.65;
  }
  
  .flow-arrow[data-tone="accent"] { background: var(--color-accent); }
  .flow-arrow[data-tone="purple"] { background: var(--color-purple); }
  .flow-arrow[data-tone="warning"] { background: var(--color-warning); }
  .flow-arrow[data-tone="success"] { background: var(--color-success); }
  
  /* Pizza diagram */
  .pizza-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 74px minmax(260px, 1.25fr) 74px minmax(0, 1fr);
    align-items: center;
    gap: 0;
  }
  
  .pizza-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }
  
  .pizza-node {
