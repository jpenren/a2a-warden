---
// Hero.astro - Hero section with value proposition, CTAs, key metrics, and architecture overview
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
}

const {
  title = "A2A Warden",
  subtitle = "Trusted intermediary for Agent2Agent communication",
  description = "Hub-and-spoke architecture that records all traffic, verifies signed Agent Cards (JWS/JCS), applies Cedar policies with deny-by-default, and enables human-in-the-loop approvals — all in a single Rust executable."
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-glow" aria-hidden="true"></div>

    <header class="hero-header">
      <div class="hero-badge" data-animate="fade-in-up">
        <span class="badge badge--accent">A2A v1.0 Compatible</span>
        <span class="badge badge--success">Open Source</span>
        <span class="badge badge--purple">Rust</span>
      </div>

      <h1 id="hero-title" class="hero-title" data-animate="fade-in-up" style="animation-delay: 100ms;">
        <span class="hero-title-main">{title}</span>
        <span class="hero-title-sub">{subtitle}</span>
      </h1>

      <p class="hero-description" data-animate="fade-in-up" style="animation-delay: 200ms;">
        {description}
      </p>

      <div class="hero-cta btn-group" data-animate="fade-in-up" style="animation-delay: 300ms;">
        <a href="#quickstart" class="btn btn--primary btn--lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Get Started
        </a>
        <a href="https://github.com/jpenren/a2a-warden" target="_blank" rel="noopener noreferrer" class="btn btn--secondary btn--lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>

      <!-- Key Metrics -->
      <div class="hero-metrics" data-animate="fade-in-up" style="animation-delay: 400ms;" role="list" aria-label="Key metrics">
        <div class="metric" role="listitem">
          <span class="metric-value">1</span>
          <span class="metric-label">Single Binary</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric" role="listitem">
          <span class="metric-value">0</span>
          <span class="metric-label">External Deps</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric" role="listitem">
          <span class="metric-value">2</span>
          <span class="metric-label">DB Backends</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric" role="listitem">
          <span class="metric-value">100%</span>
          <span class="metric-label">Type Safe</span>
        </div>
      </div>
    </header>

    <!-- Architecture overview -->
    <div class="hero-arch" data-animate="fade-in-up" style="animation-delay: 500ms;" role="group" aria-label="A2A Warden architecture: Agent A and Agent B communicate through the Warden, which records traffic, verifies Agent Cards, applies Cedar policies, and escalates tasks for human approval">
      <div class="arch-flow">
        <div class="arch-node arch-node--a">
          <div class="arch-node-head">
            <span class="arch-node-title">Agent A</span>
            <span class="arch-node-sub">Python SDK</span>
          </div>
          <div class="arch-pill">createTask()</div>
          <div class="arch-pill arch-pill--muted">getTaskStatus()</div>
        </div>

        <div class="arch-link arch-link--in" aria-hidden="true">
          <span class="arch-link-label">JSON-RPC</span>
          <span class="arch-link-line"></span>
        </div>

        <div class="arch-hub">
          <div class="arch-hub-head">
            <span class="arch-hub-title">A2A Warden</span>
            <span class="arch-hub-sub">Trust boundary</span>
          </div>
          <div class="arch-hub-grid">
            <div class="arch-module arch-module--accent">
              <strong>A2A Hub</strong>
              <span>JSON-RPC · Agent Card</span>
            </div>
            <div class="arch-module arch-module--success">
              <strong>Policy</strong>
              <span>Cedar · deny by default</span>
            </div>
            <div class="arch-module arch-module--warning">
              <strong>Approvals</strong>
              <span>Human-in-the-loop</span>
            </div>
            <div class="arch-module arch-module--cyan">
              <strong>Audit</strong>
              <span>Hash-chained log</span>
            </div>
          </div>
        </div>

        <div class="arch-link arch-link--out" aria-hidden="true">
          <span class="arch-link-label">JSON-RPC</span>
          <span class="arch-link-line"></span>
        </div>

        <div class="arch-node arch-node--b">
          <div class="arch-node-head">
            <span class="arch-node-title">Agent B</span>
            <span class="arch-node-sub">Rust SDK</span>
          </div>
          <div class="arch-pill">handleTask()</div>
          <div class="arch-pill arch-pill--muted">TaskStatusUpdate</div>
        </div>
      </div>

      <p class="arch-caption">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Every hop is recorded, verified, and policy-checked. Sensitive skills escalate to <strong>human approval</strong> in the embedded console.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-3xl) 0 clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
  }
  
  .hero-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 120vw);
    height: 440px;
    background: radial-gradient(ellipse at center, var(--color-accent-bg) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  
  .hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
  }
  
  .hero-badge {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-bottom: var(--space-lg);
  }
  
  .hero-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  
  .hero-title-main {
    color: var(--color-text);
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .hero-title-sub {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    color: var(--color-text-secondary);
    background: none;
    -webkit-text-fill-color: initial;
  }
  
  .hero-description {
    font-size: clamp(1.0625rem, 2.5vw, 1.1875rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }
  
  .hero-cta {
    margin-top: var(--space-2xl);
  }
  
  .hero-metrics {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }
  
  .metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    min-width: 96px;
  }
  
  .metric-value {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    font-family: var(--font-mono);
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-purple) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }
  
  .metric-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  
  .metric-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, var(--color-border), transparent);
  }
  
  /* Architecture flow */
  .hero-arch {
    max-width: 1060px;
    margin: 0 auto;
  }
  
  .arch-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 82px minmax(0, 1.35fr) 82px minmax(0, 1fr);
    align-items: center;
    gap: 0;
  }
  
  .arch-node,
  .arch-hub {
    min-width: 0;
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
  }
  
  .arch-node {
    border: 1px solid var(--color-border-light);
  }
  
  .arch-node--a {
    border-color: var(--color-accent-border);
  }
  
  .arch-node--b {
    border-color: var(--color-success-border);
  }
  
  .arch-node-head {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  
  .arch-node-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }
  
  .arch-node--a .arch-node-title {
    color: var(--color-accent);
  }
  
  .arch-node--b .arch-node-title {
    color: var(--color-success);
  }
  
  .arch-node-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  
  .arch-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.625rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .arch-pill + .arch-pill {
    margin-top: var(--space-sm);
  }
  
  .arch-pill--muted {
    color: var(--color-text-secondary);
  }
  
  .arch-hub {
    position: relative;
    padding: var(--space-lg);
    border: 1px solid var(--color-accent-border);
    background:
      linear-gradient(180deg, var(--color-accent-bg) 0%, transparent 55%),
      var(--color-bg-card);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
  }
  
  .arch-hub-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }
  
  .arch-hub-title {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-accent-light);
  }
  
  .arch-hub-sub {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  
  .arch-hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }
  
  .arch-module {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.6rem 0.7rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  
  .arch-module strong {
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .arch-module span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .arch-module--accent strong { color: var(--color-accent); }
  .arch-module--success strong { color: var(--color-success); }
  .arch-module--warning strong { color: var(--color-warning); }
  .arch-module--cyan strong { color: var(--color-cyan); }
  
  .arch-link {
    --link-color: var(--color-accent);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    min-height: 88px;
  }
  
  .arch-link--out {
    --link-color: var(--color-success);
  }
  
  .arch-link-line {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--link-color) 100%);
  }
  
  .arch-link-line::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -1px;
    transform: translateY(-50%);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid var(--link-color);
  }
  
  .arch-link-label {
    position: absolute;
    top: calc(50% - 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: 0 var(--space-xs);
    white-space: nowrap;
  }
  
  .arch-caption {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-sm);
    max-width: 760px;
    margin: var(--space-xl) auto 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    text-align: center;
    color: var(--color-text-muted);
  }
  
  .arch-caption svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-warning);
  }
  
  .arch-caption strong {
    color: var(--color-warning);
    font-weight: 600;
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .arch-flow {
      grid-template-columns: minmax(0, 1fr);
    }
    
    .arch-link {
      min-height: 52px;
    }
    
    .arch-link-line {
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, transparent 0%, var(--link-color) 100%);
    }
    
    .arch-link-line::after {
      top: auto;
      bottom: -1px;
      right: 50%;
      transform: translateX(50%);
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 8px solid var(--link-color);
      border-bottom: 0;
    }
    
    .arch-link-label {
      top: 50%;
      left: calc(50% + 0.75rem);
      transform: translateY(-50%);
    }
    
    .arch-node,
    .arch-hub {
      width: 100%;
    }
  }
  
  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-xl);
    }
    
    .hero-metrics {
      gap: var(--space-lg);
    }
    
    .metric-divider {
      display: none;
    }
  }
  
  @media (max-width: 480px) {
    .arch-hub-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    
    .hero-metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-md);
    }
  }
</style>
